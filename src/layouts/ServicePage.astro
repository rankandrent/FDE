---
// Canonical service page (§6.1). Section order is fixed here so the spine and
// light/dark alternation can't drift per page — pages only supply content.
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import SectionNav from '../components/sections/SectionNav.astro';
import ChallengeProse from '../components/sections/ChallengeProse.astro';
import ServiceGrid from '../components/sections/ServiceGrid.astro';
import InlineCtaBand from '../components/sections/InlineCtaBand.astro';
import ProcessTimeline from '../components/sections/ProcessTimeline.astro';
import BenefitsList from '../components/sections/BenefitsList.astro';
import ComparisonTable from '../components/sections/ComparisonTable.astro';
import CaseStudyCarousel from '../components/sections/CaseStudyCarousel.astro';
import Differentiators from '../components/sections/Differentiators.astro';
import Awards from '../components/sections/Awards.astro';
import FinalCtaForm from '../components/sections/FinalCtaForm.astro';
import Faq from '../components/sections/Faq.astro';
import { clientLogos } from '../data/site';
import type { ServicePageData } from '../data/types';

interface Props { page: ServicePageData }
const { page } = Astro.props;

const navItems = [
  { label: 'Challenges', anchor: 'challenges' },
  { label: 'Services', anchor: 'services' },
  { label: 'Process', anchor: 'process' },
  { label: 'Benefits', anchor: 'benefits' },
  ...(page.comparison ? [{ label: 'Comparison', anchor: 'comparison' }] : []),
  { label: 'Case studies', anchor: 'case-studies' },
  { label: 'Why tkxel', anchor: 'why-tkxel' },
  { label: 'FAQ', anchor: 'faq' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
};
---
<BaseLayout title={page.meta.title} description={page.meta.description} schema={[faqSchema]}>
  <Hero {...page.hero} logos={clientLogos} logos_label="Related clients" />
  <SectionNav items={navItems} />
  <ChallengeProse {...page.challenges} />
  <ServiceGrid {...page.services} />
  <InlineCtaBand {...page.inlineCta} />
  <ProcessTimeline {...page.process} />
  <BenefitsList {...page.benefits} />
  {page.comparison && <ComparisonTable {...page.comparison} />}
  <CaseStudyCarousel {...page.caseStudies} />
  <Differentiators {...page.differentiators} />
  <Awards />
  <FinalCtaForm headline={page.finalCtaHeadline} />
  <Faq items={page.faq} />
</BaseLayout>
