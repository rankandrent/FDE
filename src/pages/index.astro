---
// Hub page (§6.2): HERO → SERVICE_GRID → CHALLENGE → PROCESS → CASES → DIFFERENTIATORS → AWARDS → FORM → FAQ.
// INLINE_CTA_BAND after the grid keeps the run of light sections to three.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ServiceGrid from '../components/sections/ServiceGrid.astro';
import InlineCtaBand from '../components/sections/InlineCtaBand.astro';
import ChallengeProse from '../components/sections/ChallengeProse.astro';
import ProcessTimeline from '../components/sections/ProcessTimeline.astro';
import CaseStudyCarousel from '../components/sections/CaseStudyCarousel.astro';
import Differentiators from '../components/sections/Differentiators.astro';
import Awards from '../components/sections/Awards.astro';
import FinalCtaForm from '../components/sections/FinalCtaForm.astro';
import Faq from '../components/sections/Faq.astro';
import { clientLogos } from '../data/site';
import { fdeDifferentiators } from '../data/shared';

const services = [
  { eyebrow: 'Forward deployed engineering', title: 'AI strategy and readiness', href: '/services/ai-strategy-readiness/', body: 'Maturity assessment, process mapping, and a ranked use-case portfolio with business cases. You leave with a sequenced roadmap and a clear view of whether your data can support it.' },
  { eyebrow: 'Forward deployed engineering', title: 'FDE pods', href: '/services/fde-pods/', body: 'Small embedded teams for full-stack, agentic, data engineering, and integration work. Each pod owns an outcome, ships it in your environment, and hands it over to your engineers.' },
  { eyebrow: 'Forward deployed engineering', title: 'Agentic platforms and integrations', href: '/services/agentic-platforms/', body: 'Governed connectors to your enterprise systems, knowledge assistants that cite their sources, and manual workflows rebuilt as reviewed, production-grade agents with cost controls.' },
  { eyebrow: 'Forward deployed engineering', title: 'Adoption and enablement', href: '/services/adoption-enablement/', body: 'Role-based training, internal champion networks, and train-the-trainer programmes. Adoption is measured with usage and literacy metrics so you can see which teams need support.' },
  { eyebrow: 'Forward deployed engineering', title: 'AI security and governance', href: '/services/ai-security-governance/', body: 'Agent permission reviews, adversarial testing of AI systems, and governance councils that decide which AI investments move forward and under what controls.' },
  { eyebrow: 'Forward deployed engineering', title: 'Product and engineering transformation', href: '/services/product-engineering/', body: 'AI product strategy, rapid prototype sprints, SDLC redesign for AI-assisted delivery, and incremental modernization of legacy SaaS without a multi-year rewrite.' },
];

const faq = [
  { question: 'What does forward deployed engineering mean?', answer: 'Forward deployed engineering puts engineers inside the client’s environment instead of delivering from a distance. They work in your repositories, with your data, and alongside the people who run the workflow. The approach suits AI work because most of the difficulty sits in integration, edge cases, and adoption rather than in the model itself.' },
  { question: 'Why a separate FDE site instead of tkxel.com?', answer: 'tkxel.com covers the full range of tkxel services. This site focuses on one delivery model: embedded engineering teams that take AI from strategy to production. Both are run by the same company, teams, and certifications.' },
  { question: 'Where do I start if I have no AI use cases defined yet?', answer: 'Start with the AI strategy and readiness assessment. In two to four weeks it maps your workflows, ranks use cases by value and feasibility, and checks whether your data can support them. Many clients move straight from that roadmap into an FDE pod for the top-ranked use case.' },
  { question: 'Do you work only with Claude, or with other models too?', answer: 'We work with the models your organisation has approved, including Claude, GPT, and Gemini, through direct APIs or through Amazon Bedrock, Google Vertex AI, and Azure. Model choice is made per workflow based on accuracy, cost, and data residency requirements.' },
  { question: 'Is forward deployed engineering right for every company?', answer: 'Not always. If your need is a standard capability that an off-the-shelf product already covers well, a licence is usually cheaper and faster. FDE pays back when workflows are specific to your business, span several internal systems, or carry risk that needs custom controls. We will say so on the discovery call if a product fits better.' },
  { question: 'Which regions do you cover?', answer: 'tkxel has offices in the USA, Saudi Arabia, Portugal, and Pakistan. Pods work on-site, remote, or hybrid, and we align working hours with your core team’s time zone.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
};
const orgSchema = { '@context': 'https://schema.org', '@type': 'Organization', name: 'tkxel', url: 'https://fde.tkxel.com', parentOrganization: { '@type': 'Organization', name: 'tkxel', url: 'https://tkxel.com' } };
---
<BaseLayout
  title="Forward deployed engineering for AI | tkxel FDE"
  description="tkxel forward deployed engineering teams embed with your organisation to take AI from strategy to production, then hand working systems to your team."
  schema={[orgSchema, faqSchema]}
>
  <Hero
    eyebrow="Forward deployed engineering"
    headline="AI engineers who work inside your business | until the system runs without us"
    subhead="tkxel embeds small engineering pods in your teams to scope, build, and govern production AI. You get working agents, data systems, and the internal capability to run them."
    cta_label="Book discovery call"
    logos={clientLogos}
  />
  <ServiceGrid id="services" headline="Six ways we take AI | from plan to production" services={services} />
  <InlineCtaBand headline="Not sure which engagement fits your situation?" body="A 30-minute discovery call is enough to point you to the right starting point." cta_label="Book discovery call" />
  <ChallengeProse
    headline="Does your AI programme look | like this right now?"
    challenges={[
      { title: 'Pilots everywhere, production nowhere', body: 'Several teams have prototypes, but none has passed security review or reached real users.' },
      { title: 'Strategy decks with no one to build', body: 'The roadmap is approved, yet internal engineers are fully booked on the existing product.' },
      { title: 'Licences bought, usage flat', body: 'Teams have AI tools but few changed how they work, and nobody measures adoption.' },
      { title: 'Risk teams say no by default', body: 'Without audit trails and clear autonomy limits, security has no basis to approve agents.' },
    ]}
  />
  <ProcessTimeline
    headline="How an FDE engagement | runs from first call to handover"
    steps={[
      { title: 'Assess and prioritize', timeline: '2–4 weeks', body: 'We map workflows, check data readiness, and rank use cases by value and feasibility with your business owners.', deliverables: 'Readiness scorecard, ranked use-case portfolio, roadmap' },
      { title: 'Embed the pod', timeline: '1 week', body: 'A pod of three to five engineers joins your tools, ceremonies, and access controls, paired with the engineers who will own the result.', deliverables: 'Team charter, access plan, success metrics' },
      { title: 'Build and evaluate', timeline: '4–8 weeks', body: 'The pod ships the first use case in your environment, scored against evaluation sets drawn from real work.', deliverables: 'Production-ready system, evaluation report, architecture records' },
      { title: 'Govern and release', timeline: '2–4 weeks', body: 'Guardrails, review queues, monitoring, and cost controls go live with a limited user group before wider rollout.', deliverables: 'Release plan, dashboards, runbooks' },
      { title: 'Transfer ownership', timeline: 'Ongoing, staged per system', body: 'Your engineers take over in stages while the pod moves to the next use case or steps out entirely.', deliverables: 'Ownership transfer plan, enablement sessions' },
    ]}
  />
  <CaseStudyCarousel
    headline="Featured success stories"
    cases={[
      { result_headline: '[Placeholder] Metric-led result for a forward deployed engagement, then the mechanism.', tags: ['Industry', 'FDE pod'], quote: 'Placeholder quote — replace with a real client quote.', attributor_role: 'Chief Operating Officer' },
      { result_headline: '[Placeholder] Second case study headline leading with the metric.', tags: ['Industry', 'AI readiness'], quote: 'Placeholder quote — replace with a real client quote.', attributor_role: 'Head of Data' },
      { result_headline: '[Placeholder] Third case study headline leading with the metric.', tags: ['Industry', 'Legacy modernization'], quote: 'Placeholder quote — replace with a real client quote.', attributor_role: 'VP Engineering' },
    ]}
  />
  <Differentiators {...fdeDifferentiators} />
  <Awards />
  <FinalCtaForm headline="Tell us about the workflow you want AI to handle" />
  <Faq items={faq} />
</BaseLayout>
