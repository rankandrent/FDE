---
import { pillars, nav } from '../../data/site';
---
<header class="hdr" data-hdr>
  <div class="container hdr__bar">
    <a href="/" class="hdr__logo" aria-label="tkxel FDE home">tkxel<span>FDE</span></a>
    <nav class="hdr__nav" aria-label="Primary">
      <div class="hdr__mega-wrap">
        <button class="hdr__link" aria-expanded="false" aria-controls="mega" data-mega-btn>Services</button>
        <div class="hdr__mega" id="mega" hidden data-mega>
          <div class="container hdr__mega-grid">
            {pillars.map((p) => (
              <div>
                <a href={p.href} class="hdr__mega-title">{p.title}</a>
                <ul>{p.children.map((c) => <li>{c}</li>)}</ul>
              </div>
            ))}
          </div>
        </div>
      </div>
      {nav.map((n) => <a href={n.href} class="hdr__link">{n.label}</a>)}
    </nav>
    <a href="#cta-form" class="btn btn--invert hdr__cta">Book discovery call</a>
    <button class="hdr__burger" aria-label="Open menu" aria-expanded="false" data-burger><span></span><span></span></button>
  </div>
</header>

<style>
  .hdr { position: fixed; inset: 0 0 auto; z-index: 50; color: var(--tk-white); transition: background .25s, color .25s, border-color .25s; border-bottom: 1px solid transparent; }
  .hdr.is-solid { background: var(--tk-white); color: var(--tk-text); border-color: var(--tk-border); }
  .hdr.is-solid .hdr__cta { background: var(--tk-accent); color: var(--tk-white); }
  .hdr__bar { display: flex; align-items: center; gap: 40px; height: 80px; }
  .hdr__logo { font-weight: 800; font-size: 26px; text-decoration: none; letter-spacing: -0.02em; }
  .hdr__logo span { font-family: var(--tk-mono); font-size: 13px; font-weight: 500; margin-left: 8px; padding: 3px 7px; border: 1px solid currentColor; vertical-align: middle; }
  .hdr__nav { display: flex; gap: 32px; flex: 1; }
  .hdr__link { background: none; border: 0; color: inherit; font: 500 16px var(--tk-sans); text-decoration: none; cursor: pointer; padding: 8px 0; }
  .hdr__cta { margin-left: auto; }
  .hdr__mega { position: absolute; left: 0; right: 0; top: 80px; background: var(--tk-white); color: var(--tk-text); border-top: 1px solid var(--tk-border); border-bottom: 1px solid var(--tk-border); padding: 40px 0; }
  .hdr__mega-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 40px; }
  .hdr__mega-title { font-weight: 700; text-decoration: none; color: var(--tk-accent); }
  .hdr__mega ul { list-style: none; padding: 0; margin: 12px 0 0; font-size: 15px; color: var(--tk-text-muted); display: grid; gap: 6px; }
  .hdr__burger { display: none; margin-left: auto; background: none; border: 0; width: 44px; height: 44px; cursor: pointer; color: inherit; }
  .hdr__burger span { display: block; height: 2px; background: currentColor; margin: 7px 8px; }
  @media (max-width: 1023px) {
    .hdr__nav, .hdr__cta { display: none; }
    .hdr__burger { display: block; }
    .hdr.is-open { background: var(--tk-white); color: var(--tk-text); }
    .hdr.is-open .hdr__nav { display: flex; flex-direction: column; gap: 4px; position: absolute; top: 80px; left: 0; right: 0; background: var(--tk-white); padding: 16px var(--tk-gutter) 24px; border-bottom: 1px solid var(--tk-border); max-height: calc(100vh - 80px); overflow: auto; }
    .hdr.is-open .hdr__mega { position: static; padding: 8px 0 16px; border: 0; }
    .hdr.is-open .hdr__mega .container { padding: 0; }
    .hdr__mega-grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr]')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const update = () => {
    const limit = hero ? hero.offsetHeight - 80 : 10;
    hdr.classList.toggle('is-solid', window.scrollY > limit);
  };
  update();
  window.addEventListener('scroll', update, { passive: true });

  const btn = document.querySelector<HTMLButtonElement>('[data-mega-btn]')!;
  const mega = document.querySelector<HTMLElement>('[data-mega]')!;
  const setMega = (open: boolean) => { mega.hidden = !open; btn.setAttribute('aria-expanded', String(open)); };
  btn.addEventListener('click', () => setMega(mega.hidden));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMega(false); });
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.hdr__mega-wrap')) setMega(false); });

  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;
  burger.addEventListener('click', () => {
    const open = hdr.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(open));
  });
</script>
