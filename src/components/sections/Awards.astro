---
// Global block (§4.18) — maintained centrally, do not reorder per page.
const awards = ['Inc. 5000', 'Top 15 Inspiring Workplaces', 'Titan Business Platinum (AI & Automation)', 'Financial Times', 'Mogul People Leader', 'Forbes Coaches Council', 'ISO 27001', 'ISO 20000', 'ISO 9001', 'CMMI DEV 3'];
---
<section class="section aw">
  <div class="container">
    <h2 class="h2 aw__h reveal">We've been recognized by the best, year after year</h2>
    <ul class="aw__list">{awards.map((a) => <li class="aw__badge"><span class="aw__dot" aria-hidden="true"></span>{a}</li>)}</ul>
  </div>
</section>
<style>
  .aw { background: var(--tk-white); }
  .aw__h { text-align: center; max-width: 600px; margin: 0 auto 56px; }
  .aw__list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .aw__badge { border: 1px solid var(--tk-border); padding: 24px 16px; text-align: center; font-size: 15px; font-weight: 600; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .aw__dot { width: 48px; height: 48px; border-radius: 50%; background: var(--tk-accent-soft); }
  @media (max-width: 1023px) { .aw__list { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 767px) { .aw__list { grid-template-columns: repeat(2, 1fr); } }
</style>
