---
import Headline from './Headline.astro';
interface Step { title: string; body: string; deliverables?: string; timeline?: string }
interface Props { id?: string; headline: string; steps: Step[] }
const { id = 'process', headline, steps } = Astro.props;
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="section pt" id={id} data-pt>
  <div class="container">
    <div class="section-head reveal"><Headline text={headline} /></div>
    <div class="pt__grid">
      <div class="pt__left" aria-hidden="true">
        <span class="pt__num" data-pt-num>01</span>
        <svg viewBox="0 0 300 260" class="pt__stack">
          {steps.map((_, i) => {
            const y = 40 + (steps.length - 1 - i) * 36;
            return <polygon data-pt-layer={i} class:list={['pt__layer', { 'is-active': i === 0 }]} points={`150,${y} 280,${y + 40} 150,${y + 80} 20,${y + 40}`} />;
          })}
        </svg>
      </div>
      <ol class="pt__list">
        {steps.map((s, i) => (
          <li class:list={['pt__step', { 'is-active': i === 0 }]} data-pt-step={i}>
            <button class="pt__btn" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class="pt__n">{n(i)}</span><span class="pt__title">{s.title}</span>
              {s.timeline && <span class="caption pt__time">{s.timeline}</span>}
            </button>
            <div class="pt__body">
              <p>{s.body}</p>
              {s.deliverables && <p class="caption"><strong>Deliverables:</strong> {s.deliverables}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .pt__grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 64px; }
  .pt__num { font-size: 120px; font-weight: 800; line-height: 1; background: var(--tk-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .pt__stack { margin-top: 24px; max-width: 360px; }
  .pt__layer { fill: var(--tk-accent-soft); stroke: rgba(7,85,233,.35); stroke-width: 1; transition: fill .3s; }
  .pt__layer.is-active { fill: var(--tk-accent); stroke: var(--tk-accent); }
  .pt__list { list-style: none; margin: 0; padding: 0; }
  .pt__step { border-bottom: 1px solid var(--tk-border); }
  .pt__step:first-child { border-top: 1px solid var(--tk-border); }
  .pt__btn { width: 100%; display: flex; align-items: baseline; gap: 20px; padding: 24px 0; background: none; border: 0; text-align: left; cursor: pointer; font: inherit; color: inherit; }
  .pt__n { font-family: var(--tk-mono); font-size: 14px; color: var(--tk-text-muted); }
  .pt__title { font-size: 24px; font-weight: 700; flex: 1; }
  .pt__step.is-active .pt__n { color: var(--tk-accent); }
  .pt__body { padding-left: 46px; max-height: 0; overflow: hidden; transition: max-height .35s ease, padding .35s ease; }
  .pt__step.is-active .pt__body { max-height: 400px; padding-bottom: 24px; }
  .pt__body .caption { margin-top: 12px; }
  @media (max-width: 1023px) { .pt__grid { grid-template-columns: 1fr; } .pt__left { display: none; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-pt]').forEach((sec) => {
    const steps = [...sec.querySelectorAll<HTMLElement>('[data-pt-step]')];
    const layers = [...sec.querySelectorAll<SVGElement>('[data-pt-layer]')];
    const num = sec.querySelector<HTMLElement>('[data-pt-num]')!;
    const activate = (i: number) => {
      steps.forEach((s, j) => { s.classList.toggle('is-active', i === j); s.querySelector('button')!.setAttribute('aria-expanded', String(i === j)); });
      layers.forEach((l, j) => l.classList.toggle('is-active', i === j));
      num.textContent = String(i + 1).padStart(2, '0');
    };
    steps.forEach((s, i) => {
      s.addEventListener('mouseenter', () => activate(i));
      s.querySelector('button')!.addEventListener('click', () => activate(i));
    });
  });
</script>
