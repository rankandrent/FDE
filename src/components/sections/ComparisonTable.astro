---
import Headline from './Headline.astro';
interface Props { id?: string; headline: string; intro?: string; columns: string[]; rows: { criterion: string; values: string[] }[]; highlight?: number }
const { id = 'comparison', headline, intro, columns, rows, highlight = 2 } = Astro.props;
---
<section class="section section--alt" id={id}>
  <div class="container">
    <div class="section-head reveal"><Headline text={headline} />{intro && <p class="muted">{intro}</p>}</div>
    <div class="ct__scroll reveal" tabindex="0" role="region" aria-label="Comparison table">
      <table class="ct">
        <thead><tr><th scope="col"><span class="sr-only">Criterion</span></th>{columns.map((c, i) => <th scope="col" class:list={{ 'is-hl': i === highlight }}>{c}</th>)}</tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr><th scope="row">{r.criterion}</th>{r.values.map((v, i) => <td class:list={{ 'is-hl': i === highlight }}>{v}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
<style>
  .ct__scroll { overflow-x: auto; }
  .ct { width: 100%; min-width: 760px; border-collapse: collapse; background: var(--tk-white); font-size: 16px; }
  .ct th, .ct td { padding: 20px 24px; text-align: left; border-bottom: 1px solid var(--tk-border); vertical-align: top; }
  .ct thead th { font-family: var(--tk-mono); font-size: 14px; text-transform: uppercase; letter-spacing: .08em; color: var(--tk-text-muted); font-weight: 500; }
  .ct tbody th { font-weight: 700; width: 22%; }
  .ct .is-hl { background: var(--tk-accent-soft); }
  .ct thead .is-hl { background: var(--tk-accent); color: var(--tk-white); }
</style>
