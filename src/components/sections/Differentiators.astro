---
import Headline from './Headline.astro';
interface Props { id?: string; headline: string; points: { title: string; body: string }[]; cta_label: string; cta_target?: string }
const { id = 'why-tkxel', headline, points, cta_label, cta_target = '#cta-form' } = Astro.props;
---
<section class="section section--gradient on-dark" id={id}>
  <div class="container">
    <div class="df__head reveal"><Headline text={headline} /><a href={cta_target} class="btn btn--invert">{cta_label}</a></div>
    <div class="df">
      {points.map((p) => <div class="df__card reveal"><h3 class="df__title">{p.title}</h3><p>{p.body}</p></div>)}
    </div>
  </div>
</section>
<style>
  .df__head { text-align: center; max-width: 1040px; margin: 0 auto 56px; display: flex; flex-direction: column; align-items: center; gap: 32px; }
  .df { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .df__card { background: rgba(255,255,255,.08); padding: 32px; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; min-height: 300px; }
  .df__card p { font-size: 16px; color: rgba(255,255,255,.78); }
  .df__title { font-size: 24px; font-weight: 600; }
  @media (max-width: 1023px) { .df { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 767px) { .df { grid-template-columns: 1fr; } .df__card { min-height: 0; } }
</style>
