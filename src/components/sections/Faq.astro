---
interface Props { id?: string; items: { question: string; answer: string }[] }
const { id = 'faq', items } = Astro.props;
---
<section class="section" id={id}>
  <div class="container faq">
    <h2 class="h2 reveal">Frequently asked questions</h2>
    <div>
      {items.map((it, i) => (
        <details class="faq__item" open={i === 0}>
          <summary><span>{it.question}</span><span class="faq__icon" aria-hidden="true"></span></summary>
          <p>{it.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq { display: grid; grid-template-columns: 1fr 2fr; gap: 64px; }
  .faq__item { border-bottom: 1px solid var(--tk-border); }
  .faq__item:first-child { border-top: 1px solid var(--tk-border); }
  .faq__item summary { list-style: none; display: flex; justify-content: space-between; gap: 24px; padding: 24px 0; cursor: pointer; font-weight: 700; font-size: 20px; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__icon::before { content: '+'; font-size: 24px; color: var(--tk-accent); }
  .faq__item[open] .faq__icon::before { content: '−'; }
  .faq__item p { padding: 0 0 24px; color: var(--tk-text-muted); }
  @media (max-width: 1023px) { .faq { grid-template-columns: 1fr; gap: 32px; } }
</style>
