---
import Headline from './Headline.astro';
interface Props { headline: string; body?: string; cta_label: string; cta_target?: string }
const { headline, body, cta_label, cta_target = '#cta-form' } = Astro.props;
---
<section class="icb section--gradient on-dark">
  <div class="container icb__row">
    <Headline text={headline} />
    <div class="icb__right">
      {body && <p>{body}</p>}
      <a href={cta_target} class="btn btn--invert">{cta_label}</a>
    </div>
  </div>
</section>
<style>
  .icb { padding: 72px 0; }
  .icb__row { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; }
  .icb__right { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; color: rgba(255,255,255,.85); }
  @media (max-width: 767px) { .icb__row { grid-template-columns: 1fr; gap: 24px; } }
</style>
